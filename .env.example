# Copy to .env and uncomment what you want to change. All values shown are the defaults.

# Where the models come from: a Hugging Face Hub id or a local folder
# CAPTION_MODEL_LARGE=Salesforce/blip-image-captioning-large
# CAPTION_MODEL_BASE=Salesforce/blip-image-captioning-base
# ITM_MODEL=Salesforce/blip-itm-base-coco
# VQA_MODEL=Salesforce/blip-vqa-base

# DEFAULT_CAPTION_MODEL=large      # large (accurate) | base (fast, good for old laptops)
# DEVICE=auto                      # auto | cpu | cuda | mps
# PRELOAD_MODELS=true              # load models at startup instead of on first use
# ENABLE_ITM=true                  # re-ranking, Match tab and attention heatmaps
# ENABLE_VQA=true                  # Ask tab
# TORCH_THREADS=0                  # 0 = all CPU cores but one

# HOST=127.0.0.1                   # use 0.0.0.0 to open the app to phones on the same Wi-Fi
# PORT=8000
# MAX_UPLOAD_MB=15
# MAX_BATCH_FILES=12
# RESULT_CACHE_SIZE=64

# Offline mode (after scripts/convert_original_blip.py):
# CAPTION_MODEL_LARGE=models/blip-caption-large
# CAPTION_MODEL_BASE=models/blip-caption-base
# ITM_MODEL=models/blip-itm-base
# VQA_MODEL=models/blip-vqa-base
